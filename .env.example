# .env.example
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should never be committed

# ============================================================
# LangSmith Configuration (REQUIRED for evaluations)
# ============================================================
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT_NAME=endpoint_selection_evaluation_v2
LANGSMITH_DATASET_NAME=endpoint_selection_test_cases
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# OLLAMA Configuration (for local LLM inference)
# ============================================================
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MODEL_ROUTER=deepseek-coder:6.7b
OLLAMA_MODEL_ANSWER=llama3.2:latest
USE_OLLAMA=1

# ============================================================
# ERP API Configuration
# ============================================================
ERP_API_BASE_URL=https://localhost:44393
ERP_API_BEARER_TOKEN=your_bearer_token_here

# ============================================================
# Endpoint Configuration
# ============================================================
ERP_ENDPOINT_SOURCE=swagger
ERP_LOAD_SWAGGER_ENDPOINTS=1
ERP_ROUTER_CANDIDATE_LIMIT=12

# ============================================================
# MongoDB Configuration (optional, for staging large results)
# ============================================================
MONGODB_URI=
MONGODB_DB_NAME=erp_assistant_staging
MONGODB_STAGING_THRESHOLD=50

# ============================================================
# HTTP Server Configuration
# ============================================================
ERP_ASSISTANT_HOST=127.0.0.1
ERP_ASSISTANT_PORT=8000

# ============================================================
# Logging & Debug
# ============================================================
DEBUG=0
LOG_LEVEL=INFO
